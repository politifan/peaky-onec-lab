// НАМЕРЕННО НЕВЕРНО. Общий серверный модуль отдельной копии базы.
// Пакет — массив структур Товар (ссылка) и СтарыйНомер (число).
// Симптомы: legacy-коды затираются; сбой оставляет частично записанный пакет.
Процедура МигрироватьПакет(Пакет, СбойПослеПервого = Истина) Экспорт
    Номер = 0;
    Для Каждого Стр Из Пакет Цикл
        Объект = Стр.Товар.ПолучитьОбъект();
        Объект.ВнешнийКод = "T-" + Формат(Стр.СтарыйНомер, "ЧГ=0");
        Объект.Записать();
        Номер = Номер + 1;
        Если СбойПослеПервого И Номер = 1 Тогда
            ВызватьИсключение "Учебный сбой после первой записи";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
