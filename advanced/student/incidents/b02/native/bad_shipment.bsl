// НАМЕРЕННО НЕВЕРНО. Запускайте без внешней транзакции, только в копии.
// Симптомы: отдельный регистратор на строку оставляет частичный расход;
// повтор вызова создаёт новые документы и повторный эффект.
Процедура ОтгрузитьЗаказ(Заказ) Экспорт
    ОбъектЗаказа = Заказ.ПолучитьОбъект();
    Для Каждого Стр Из ОбъектЗаказа.Товары Цикл
        Расход = Документы.Отгрузка.СоздатьДокумент();
        Расход.Дата = ОбъектЗаказа.Дата;
        Расход.Склад = ОбъектЗаказа.Склад;
        Расход.Заказ = Заказ;
        Товар = Расход.Товары.Добавить();
        Товар.Товар = Стр.Товар;
        Товар.Количество = Стр.Количество;
        Расход.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
КонецПроцедуры
