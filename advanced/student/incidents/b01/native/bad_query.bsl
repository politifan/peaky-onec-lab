// НАМЕРЕННО НЕВЕРНО. Общий серверный модуль отдельной копии стенда.
// Симптомы: две цены размножают A; B без цены исчезает.
Функция СтоимостьЗаказа(Заказ, Момент) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Т.НомерСтроки, Т.Товар, Т.Количество * Ц.Цена КАК Стоимость
    |ИЗ Документ.Заказ.Товары КАК Т
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Цены КАК Ц
    |ПО Т.Товар = Ц.Товар
    |ГДЕ Т.Ссылка = &Заказ";
    Запрос.УстановитьПараметр("Заказ", Заказ);
    // Момент передан, но намеренно не участвует в выборе цены.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
