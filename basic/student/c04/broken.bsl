Функция ОшибочныйПовтор(СсылкаДокумента) Экспорт
    Исходный = СсылкаДокумента.ПолучитьОбъект();
    НовыйДокумент = Документы.Поступление.СоздатьДокумент();
    НовыйДокумент.Дата = Исходный.Дата;
    НовыйДокумент.Товары.Загрузить(Исходный.Товары.Выгрузить());
    НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
    Возврат СсылкаДокумента;
КонецФункции
